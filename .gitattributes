# Global defaults
* text=auto

# Force LF for source/docs/data
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.csv text eol=lf

*.py text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf

*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.editorconfig text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Keep notebooks as LF to avoid CRLF conversion issues
*.ipynb text eol=lf

# Windows-native file formats
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.pdf -text
*.pbix -text
*.xlsx -text
*.xls -text
*.zip -text
*.nupkg -text
*.dll -text
*.exe -text